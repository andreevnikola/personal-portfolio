---
import Layout from '../layouts/Layout.astro';

const email = 'nikola@aandreev.me';

const projects = [
  {
    handle: 'interactclub.philippopol',
    title: 'Interact Club Philippopol',
    note: 'Our youth service club in Plovdiv.',
  },
  {
    handle: 'interactd2482',
    title: 'Interact District 2482',
    note: 'Interact Bulgaria, the wider network.',
  },
  {
    handle: 'tepe.bite',
    title: 'Tepe Bite',
    note: 'A project I run.',
  },
];

const columns = [
  [
    { src: '/images/tour-group.jpg', alt: 'A tour group posing in a snowy pine forest', w: 948, h: 826 },
    { src: '/images/tour-reindeer.jpg', alt: 'Feeding a reindeer at a snowy fence', w: 768, h: 1024 },
  ],
  [
    { src: '/images/tour-aurora.jpg', alt: 'Two people standing under the northern lights', w: 768, h: 1024 },
    { src: '/images/tour-desert.jpg', alt: 'Quad bikes on desert dunes', w: 816, h: 960 },
  ],
];

const year = new Date().getFullYear();
---

<Layout title="Nikola Andreev" description="Nikola Andreev: student projects, stages and trips.">
  <p class="notice" role="note">
    This page isn't finished and isn't meant to be shared yet. Thanks, Claude.
  </p>

  <div class="wrap">
    <header class="bar">
      <a class="mark" href="#top">Nikola Andreev</a>
      <nav aria-label="Primary">
        <a href="#tours">Tours</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <img
          class="cover"
          src="/images/cover.jpg"
          alt="Nikola reading from notes at a microphone on stage, a flag behind him"
          width="2000"
          height="1150"
        />
        <h1>
          <span>Nikola</span>
          <span>Andreev</span>
        </h1>
        <div class="lede">
          <img class="portrait" src="/images/portrait.jpg" alt="Portrait of Nikola at a microphone" width="892" height="892" />
          <p>
            I run student projects, speak on stage, and guide trips from the Arctic to the desert.
          </p>
        </div>
      </section>

      <section id="tours" class="split">
        <div class="side">
          <h2>Tours</h2>
          <p>
            I guide trips for <a href="https://abax.bg" target="_blank" rel="noopener noreferrer">ABAX.BG</a>.
            Northern lights, reindeer farms and dune rides are all part of the job.
          </p>
        </div>
        <div class="photos">
          {
            columns.map((col) => (
              <div class="col">
                {col.map((p) => (
                  <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <section id="projects">
        <div class="side wide">
          <h2>Projects</h2>
          <p>Clubs and ideas I'm building with other people. Live from Instagram.</p>
        </div>
        <ul class="embeds">
          {
            projects.map((p) => (
              <li>
                <iframe
                  src={`https://www.instagram.com/${p.handle}/embed`}
                  title={`Instagram profile @${p.handle}`}
                  loading="lazy"
                  scrolling="no"
                />
                <div class="cap">
                  <h3>{p.title}</h3>
                  <p>{p.note}</p>
                  <a href={`https://www.instagram.com/${p.handle}/`} target="_blank" rel="noopener noreferrer">
                    Open @{p.handle}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="contact" class="contact">
        <h2>Contact</h2>
        <a class="mail" href={`mailto:${email}`}>{email}</a>
        <p class="elsewhere">
          Also on{' '}
          <a href="https://www.linkedin.com/in/nikola-andreev-736a5b3a3/" target="_blank" rel="noopener noreferrer">LinkedIn</a>{' '}
          and{' '}
          <a href="https://www.instagram.com/andreevnikolaa/" target="_blank" rel="noopener noreferrer">Instagram</a>.
        </p>
      </section>
    </main>

    <footer>
      <p>© {year} Nikola Andreev</p>
    </footer>
  </div>
</Layout>

<style>
  .notice {
    margin: 0;
    padding: 0.5rem var(--gutter);
    background: var(--ink);
    color: #fff;
    font-size: 0.875rem;
    text-align: center;
  }
  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.4rem 0;
  }
  .mark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.95rem;
  }
  nav a {
    text-decoration: none;
    color: var(--mute);
  }
  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  section {
    padding-top: clamp(4rem, 10vw, 8rem);
    scroll-margin-top: 1rem;
  }
  .hero {
    padding-top: 0.5rem;
  }

  .cover {
    width: 100%;
    height: clamp(260px, 56vh, 560px);
    object-fit: cover;
    object-position: 50% 62%;
    border-radius: 14px;
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: clamp(1.5rem, 4vw, 3rem) 0 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(4rem, 17.5vw, 13.5rem);
    line-height: 0.84;
    letter-spacing: -0.045em;
  }
  .lede {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 34rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .portrait {
    width: 4.25rem;
    height: 4.25rem;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .lede p {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .side p {
    margin: 0;
    max-width: 26rem;
    color: var(--mute);
  }
  .side a {
    color: var(--ink);
  }
  .side.wide {
    margin-bottom: 2.5rem;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .split .side {
    position: sticky;
    top: 2rem;
  }
  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    align-items: start;
  }
  .col {
    display: grid;
    gap: 0.85rem;
  }
  .col:last-child {
    margin-top: 3.5rem;
  }
  .photos img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .embeds {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  iframe {
    width: 100%;
    height: 415px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    display: block;
  }
  .cap {
    padding-top: 1rem;
  }
  .cap h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .cap p {
    margin: 0.2rem 0 0.5rem;
    color: var(--mute);
    font-size: 0.97rem;
  }
  .cap a {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .contact {
    padding-bottom: 1rem;
  }
  .mail {
    display: inline-block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.6rem, 6.2vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-decoration: none;
    border-bottom: 3px solid var(--ink);
    overflow-wrap: anywhere;
  }
  .mail:hover {
    border-color: var(--red);
  }
  .elsewhere {
    margin: 1.5rem 0 0;
    color: var(--mute);
  }
  .elsewhere a {
    color: var(--ink);
  }

  footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--mute);
    font-size: 0.9rem;
  }
  footer p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .embeds {
      grid-template-columns: 1fr;
      max-width: 440px;
    }
  }
  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split .side {
      position: static;
    }
    .lede p {
      font-size: 1.1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
