---
import Layout from '../layouts/Layout.astro';

const name = 'Nikola Andreev';
const email = 'nikola@aandreev.me';

const nav = [
  { href: '#tours', label: 'Tours' },
  { href: '#instagram', label: 'Instagram' },
  { href: '#contact', label: 'Contact' },
];

const instagram = [
  { handle: 'andreevnikolaa', label: 'Personal', href: 'https://www.instagram.com/andreevnikolaa/' },
  { handle: 'tepe.bite', label: 'Project', href: 'https://www.instagram.com/tepe.bite/' },
  { handle: 'interactd2482', label: 'Project', href: 'https://www.instagram.com/interactd2482/' },
  {
    handle: 'interactclub.philippopol',
    label: 'Project',
    href: 'https://www.instagram.com/interactclub.philippopol/',
  },
];

const tours = [
  { src: '/images/tour-group.jpg', alt: 'Tour group posing in a snowy pine forest' },
  { src: '/images/tour-aurora.jpg', alt: 'Two people standing under the northern lights' },
  { src: '/images/tour-reindeer.jpg', alt: 'Feeding a reindeer at a snowy fence' },
  { src: '/images/tour-desert.jpg', alt: 'Quad bikes on desert dunes' },
];

const links = [
  { label: 'Email', href: `mailto:${email}` },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nikola-andreev-736a5b3a3/' },
  { label: 'Instagram', href: 'https://www.instagram.com/andreevnikolaa/' },
];
const year = new Date().getFullYear();
---

<Layout title={name} description={`${name} — tour guide at ABAX and founder of student projects.`}>
  <header class="top">
    <a class="logo" href="#top">{name}</a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <img class="cover" src="/images/cover.jpg" alt="Nikola speaking on stage" width="2000" height="1150" />
      <div class="intro">
        <img class="portrait" src="/images/portrait.jpg" alt={name} width="120" height="120" />
        <div>
          <h1>{name}</h1>
          <p class="lead">
            Tour guide at <a href="https://abax.bg">ABAX</a>.
          </p>
        </div>
      </div>
    </section>

    <section id="tours">
      <h2>Tours</h2>
      <p class="text">
        I work as a tour guide at <a href="https://abax.bg">ABAX.BG</a>. Some moments from my trips.
      </p>
      <ul class="gallery">
        {tours.map((t) => <li><img src={t.src} alt={t.alt} loading="lazy" /></li>)}
      </ul>
    </section>

    <section id="instagram">
      <h2>Instagram</h2>
      <ul class="cards">
        {
          instagram.map((i) => (
            <li>
              <a class="card" href={i.href} target="_blank" rel="noopener noreferrer">
                <span class="tag">{i.label}</span>
                <span class="handle">@{i.handle}</span>
                <span class="go">View on Instagram →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p class="text"><a href={`mailto:${email}`}>{email}</a></p>
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  </main>

  <footer>
    <p>© {year} {name}</p>
  </footer>
</Layout>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem max(1.25rem, calc((100% - 960px) / 2));
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .logo {
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--fg);
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  section {
    padding: 3rem 0;
    scroll-margin-top: 3.5rem;
  }
  .hero {
    padding-top: 1.5rem;
  }
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 12px;
    display: block;
  }
  .intro {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .portrait {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0.25rem 0 0;
  }
  .text {
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .gallery,
  .cards,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }
  .cards {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .handle {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .go {
    font-size: 0.9rem;
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  footer p {
    margin: 0;
  }
  @media (max-width: 520px) {
    .cover {
      aspect-ratio: 16 / 10;
    }
    .intro {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
