---
import Layout from '../layouts/Layout.astro';

const name = 'Nikola Andreev';
const role = 'Software Developer';

const nav = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];

const skills = ['TypeScript', 'JavaScript', 'Astro', 'React', 'Node.js', 'HTML & CSS', 'Git'];

// TODO: replace with real projects.
const projects = [
  {
    title: 'Personal Portfolio',
    description: 'This site. Static, fast, built with Astro.',
    href: 'https://github.com/andreevnikola/personal-portfolio',
    tags: ['Astro', 'TypeScript'],
  },
  {
    title: 'Project Two',
    description: 'Short description of what it does and why it matters.',
    href: '#',
    tags: ['Tag'],
  },
  {
    title: 'Project Three',
    description: 'Short description of what it does and why it matters.',
    href: '#',
    tags: ['Tag'],
  },
];

const email = 'andr.nikola.08@gmail.com';
const links = [
  { label: 'GitHub', href: 'https://github.com/andreevnikola' },
  { label: 'Email', href: `mailto:${email}` },
];
const year = new Date().getFullYear();
---

<Layout
  title={`${name} — ${role}`}
  description={`Personal portfolio of ${name}, ${role}.`}
>
  <header class="top">
    <a class="logo" href="#top">NA</a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <p class="eyebrow">Hi, I'm</p>
      <h1>{name}</h1>
      <p class="lead">{role}. I build clean, fast and accessible things for the web.</p>
      <div class="cta">
        <a class="btn primary" href="#projects">See my work</a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </section>

    <section id="about">
      <h2>About</h2>
      <p>
        I'm Nikola, a developer who enjoys turning ideas into polished products. Replace this
        paragraph with a short story about your background, what you're working on, and what
        you're looking for next.
      </p>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <ul class="chips">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <ul class="grid">
        {
          projects.map((p) => (
            <li class="card">
              <h3><a href={p.href}>{p.title}</a></h3>
              <p>{p.description}</p>
              <ul class="tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>Open to new opportunities and interesting projects. Say hello:</p>
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  </main>

  <footer>
    <p>© {year} {name}</p>
  </footer>
</Layout>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem max(1.25rem, calc((100% - 960px) / 2));
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .logo {
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--fg);
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--fg);
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  section {
    padding: 4rem 0;
    scroll-margin-top: 3.5rem;
  }
  .hero {
    padding: 7rem 0 5rem;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    margin: 0;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.05;
    margin: 0.25rem 0 1rem;
    letter-spacing: -0.03em;
  }
  h2 {
    font-size: 1.6rem;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }
  .lead {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 38rem;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .btn {
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
  }
  .btn:hover {
    border-color: var(--accent);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  #about p {
    max-width: 40rem;
    color: var(--muted);
  }
  .chips,
  .tags,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .card {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card h3 {
    margin: 0 0 0.4rem;
  }
  .card h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  .card p {
    margin: 0 0 0.8rem;
    color: var(--muted);
  }
  .tags li {
    font-size: 0.8rem;
    color: var(--accent);
  }
  .links {
    gap: 1.25rem;
  }
  footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  footer p {
    margin: 0;
  }
  @media (max-width: 520px) {
    nav ul {
      gap: 0.8rem;
    }
    .hero {
      padding-top: 4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .card {
      transition: none;
    }
  }
</style>
